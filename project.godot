; Engine configuration file.
; Minimal reproduction project for Godot issue #124903:
; Android SIGABRT "pthread_mutex_lock called on a destroyed mutex"
; in render thread teardown on background/return.
; No scripts, no plugins, no ads — a bare scene on gl_compatibility.
; Repro: launch, wait ~45 s on the menu, press Home, relaunch from
; the launcher. The app crashes ~25 ms after the relaunch starts.

config_version=5

[application]

config/name="Godot124903Repro"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=540
window/size/viewport_height=960
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
